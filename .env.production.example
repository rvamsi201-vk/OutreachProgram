NODE_ENV=production
LOG_LEVEL=info
API_REQUEST_LOGGING=false
DB_LOG_QUERIES=false

APP_URL=https://crm.example.com
VITE_API_URL=https://crm.example.com

DATABASE_URL=postgresql://ai_crm:${POSTGRES_PASSWORD}@postgres:5432/ai_crm
REDIS_URL=redis://redis:6379
API_PORT=3000
VOICE_GATEWAY_PORT=3100
API_URL=http://api:3000
BAILEYS_WEBSOCKET_URL=wss://web.whatsapp.com/ws/chat
BAILEYS_BROWSER_NAME=AI Outreach CRM
BAILEYS_LOG_LEVEL=warn
# Installed by apps/api/package.json: @whiskeysockets/baileys@6.7.24.
# WhatsApp session state is encrypted in Postgres; keep ENCRYPTION_KEY stable.

# Server-only LLM. Store the real key in your deployment secret manager.
LLM_PROVIDER=openai-compatible
OPENAI_API_KEY=replace-with-openrouter-or-openai-compatible-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=qwen/qwen3.8-27b:free
LLM_EMBEDDING_MODEL=local-hash

# Gmail OAuth. Add this exact callback URL in Google Cloud OAuth credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=https://crm.example.com/api/channel-accounts/gmail/oauth/callback

JWT_SECRET=replace-with-64-random-characters
REFRESH_SECRET=replace-with-another-64-random-characters
ENCRYPTION_KEY=replace-with-32-byte-or-longer-secret

POSTGRES_DB=ai_crm
POSTGRES_USER=ai_crm
POSTGRES_PASSWORD=replace-with-strong-database-password

DOMAIN=crm.example.com
LETSENCRYPT_EMAIL=admin@example.com
