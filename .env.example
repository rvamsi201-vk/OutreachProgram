# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_crm_dev
REDIS_URL=redis://localhost:6379
POSTGRES_PORT=5432
REDIS_PORT=6379
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LTMyLWJ5dGVz
APP_URL=http://localhost:5173
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
API_REQUEST_LOGGING=false
DB_LOG_QUERIES=false
BAILEYS_WEBSOCKET_URL=wss://web.whatsapp.com/ws/chat
BAILEYS_BROWSER_NAME=AI Outreach CRM
BAILEYS_LOG_LEVEL=warn
# Installed by apps/api/package.json: @whiskeysockets/baileys@6.7.24.
# Do not paste Baileys auth/session files into this env. The CRM encrypts
# WhatsApp session state in Postgres per organization and channel account.

# Server-only LLM. Do not expose this in VITE_* or browser settings.
LLM_PROVIDER=openai-compatible
# For OpenRouter, paste the OpenRouter API key here.
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=qwen/qwen3.8-27b:free
LLM_EMBEDDING_MODEL=local-hash

# Gmail OAuth for EMAIL inbox/outreach connection
# Local callback must match the Google Cloud OAuth redirect URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/channel-accounts/gmail/oauth/callback

# Frontend
VITE_API_URL=http://localhost:3000
